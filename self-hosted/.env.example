# Public HTTPS name for the Convex backend (the site's CONVEX_URL)
CONVEX_API_DOMAIN=api.mavladi.example

# Pin the images you run in production so an unattended `docker compose pull`
# can't swap the engine handling your payments. Tags:
#   https://github.com/get-convex/convex-backend/pkgs/container/convex-backend
CONVEX_BACKEND_TAG=latest
CONVEX_DASHBOARD_TAG=latest

# Only needed if you uncomment the dashboard block in the Caddyfile. By default
# the dashboard is bound to loopback and reached over an SSH tunnel:
#   ssh -L 6791:127.0.0.1:6791 you@your-server
# CONVEX_DASHBOARD_DOMAIN=convex.mavladi.example

# Optional: a stable instance name/secret (the backend generates defaults)
# INSTANCE_NAME=mavladi
# INSTANCE_SECRET=<64 hex chars, e.g. `openssl rand -hex 32`>

# Optional: keep the data in Postgres instead of the built-in SQLite
# POSTGRES_URL=postgresql://user:pass@host:5432
