# Copy to .env (or set in your host's dashboard)
PORT=3000
# Where the SQLite database and uploaded screenshots live. Must be a persistent disk.
DATA_DIR=./data
# Admin password used on FIRST boot only (afterwards change it in Admin → Settings)
ADMIN_PASSWORD=change-me-please
# Behind a reverse proxy / HTTPS load balancer (Render, Railway, nginx): set to true
TRUST_PROXY=true
# Public URL used inside ticket QR codes (optional; defaults to the request host)
PUBLIC_URL=https://passes.example.com
