# ---- Frontend build (npm run build / Vercel) ----
# The Convex deployment the site talks to: your self-hosted backend's HTTPS URL
# (e.g. https://api.mavladi.example) or https://<name>.convex.cloud
CONVEX_URL=

# ---- Deploying functions (npx convex deploy / Vercel build) ----
# Self-hosted Convex:
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=
# …or Convex cloud instead:
# CONVEX_DEPLOY_KEY=
